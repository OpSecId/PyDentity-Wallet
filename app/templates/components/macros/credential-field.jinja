{% macro render_type_badges(value) %}
    {% if value is sequence and value is not string %}
        {% set types = value %}
    {% else %}
        {% set types = [value] %}
    {% endif %}
    {% for item in types %}
        {% if item and item != 'VerifiableCredential' %}
        <span class="badge bg-azure-lt me-1 mb-1">{{ item }}</span>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% macro render_credential_value(key, value, depth=0) %}
    {% if key|lower in ('type', '@type') %}
        {{ render_type_badges(value) }}
    {% elif value is mapping %}
        {% if depth < 1 %}
        <div class="credential-nested-group border-start border-2 ps-3 ms-1">
            {% for nested_key, nested_value in value.items() %}
            <div class="d-flex flex-wrap gap-2 py-1{% if not loop.last %} border-bottom border-light{% endif %}">
                <span class="text-muted small fw-semibold" style="min-width: 5.5rem;">{{ nested_key|title }}</span>
                <div class="flex-grow-1" style="min-width: 0;">{{ render_credential_value(nested_key, nested_value, depth + 1) }}</div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <code class="small text-break">{{ value|tojson }}</code>
        {% endif %}
    {% elif value is sequence and value is not string %}
        {% if value|length == 0 %}
        <span class="text-muted">—</span>
        {% elif depth < 1 and value[0] is mapping %}
            {% for item in value %}
            <div class="credential-nested-group border-start border-2 ps-3 ms-1{% if not loop.last %} mb-2{% endif %}">
                {% for nested_key, nested_value in item.items() %}
                <div class="d-flex flex-wrap gap-2 py-1{% if not loop.last %} border-bottom border-light{% endif %}">
                    <span class="text-muted small fw-semibold" style="min-width: 5.5rem;">{{ nested_key|title }}</span>
                    <div class="flex-grow-1" style="min-width: 0;">{{ render_credential_value(nested_key, nested_value, depth + 1) }}</div>
                </div>
                {% endfor %}
            </div>
            {% endfor %}
        {% else %}
        <span class="text-break">
            {%- for item in value -%}
            {{ render_credential_value(key, item, depth + 1) }}{% if not loop.last %}, {% endif %}
            {%- endfor -%}
        </span>
        {% endif %}
    {% elif value is string and value.lower().startswith('data:image/') %}
    <img
        src="{{ value }}"
        alt="{{ key|title }}"
        class="credential-field-image rounded border bg-light"
        style="max-width: 100%; max-height: 240px; object-fit: contain;"
    >
    {% elif value is none %}
    <span class="text-muted">—</span>
    {% else %}
    <span class="text-break">{{ value }}</span>
    {% endif %}
{% endmacro %}

{% macro render_credential_fields(data) %}
    {% for key, value in data.items() %}
    <div class="col-12">
        <div class="row g-2 align-items-start">
            <div class="col-4">
                <strong class="text-muted">{{ key|title }}</strong>
            </div>
            <div class="col-8">
                {{ render_credential_value(key, value, 0) }}
            </div>
        </div>
        {% if not loop.last %}<hr class="my-2">{% endif %}
    </div>
    {% endfor %}
{% endmacro %}
