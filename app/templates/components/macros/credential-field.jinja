{% macro render_type_badges(value) %}
    {% if value is sequence and value is not string %}
        {% set types = value %}
    {% else %}
        {% set types = [value] %}
    {% endif %}
    {% for item in types %}
        {% if item and item != 'VerifiableCredential' %}
        <span class="badge bg-azure-lt me-1 mb-1">{{ item }}</span>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% macro render_credential_value(key, value) %}
    {% if key|lower in ('type', '@type') %}
        {{ render_type_badges(value) }}
    {% elif value is string and value.lower().startswith('data:image/') %}
    <img
        src="{{ value }}"
        alt="{{ key|title }}"
        class="credential-field-image rounded border bg-light"
        style="max-width: 100%; max-height: 240px; object-fit: contain;"
    >
    {% else %}
    <span class="text-break">{{ value }}</span>
    {% endif %}
{% endmacro %}
