{% set cred_count = session.get('credentials', [])|length %}
{% set conn_count = session.get('connections', [])|length %}
{% set pending_count = session.get('notifications', [])|length %}

<footer class="footer footer-transparent border-0 wallet-dock-footer">
    <div class="container-xl wallet-dock-stack">
        <div class="wallet-dock mode-wallet" id="wallet-dock">
            <nav
                class="wallet-dock-panel wallet-dock-panel--wallet"
                id="wallet-dock-wallet"
                role="tablist"
                aria-label="Wallet sections"
            >
                <button
                    type="button"
                    class="wallet-dock-nav-btn active"
                    id="credentials-tab"
                    role="tab"
                    aria-selected="true"
                    aria-label="Credentials"
                    onclick="showSection('credentials')"
                >
                    <i class="ti ti-id"></i>
                    <span class="wallet-dock-count bg-green-lt text-green-fg" id="credentials-count">{{ cred_count }}</span>
                </button>
                <button
                    type="button"
                    class="wallet-dock-nav-btn"
                    id="connections-tab"
                    role="tab"
                    aria-selected="false"
                    aria-label="Connections"
                    onclick="showSection('connections')"
                >
                    <i class="ti ti-plug-connected"></i>
                    <span class="wallet-dock-count bg-azure-lt text-azure-fg" id="connections-count">{{ conn_count }}</span>
                </button>
                <button
                    type="button"
                    class="wallet-dock-nav-btn"
                    id="notifications-tab"
                    role="tab"
                    aria-selected="false"
                    aria-label="Pending"
                    onclick="showSection('notifications')"
                >
                    <i class="ti ti-bell"></i>
                    <span class="wallet-dock-count {% if pending_count %}bg-red text-red-fg{% else %}bg-secondary-lt{% endif %}" id="pending-badge">{{ pending_count }}</span>
                </button>
            </nav>

            <nav
                class="wallet-dock-panel wallet-dock-panel--account"
                id="wallet-dock-account"
                aria-label="Account"
            >
                <button
                    type="button"
                    class="wallet-dock-nav-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#wallet-profile-modal"
                    aria-label="Profile"
                >
                    <i class="ti ti-user"></i>
                </button>
                <a
                    href="{{ url_for('auth.logout') }}"
                    class="wallet-dock-nav-btn wallet-dock-nav-btn--danger"
                    aria-label="Sign out"
                >
                    <i class="ti ti-logout"></i>
                </a>
            </nav>

            <button
                type="button"
                class="btn btn-ghost-secondary wallet-dock-toggle rounded-circle border-0"
                id="wallet-dock-toggle"
                aria-label="Show account menu"
                aria-expanded="false"
                aria-controls="wallet-dock-account"
            >
                <i class="ti ti-user-circle wallet-dock-toggle-icon wallet-dock-toggle-icon--to-account"></i>
                <i class="ti ti-wallet wallet-dock-toggle-icon wallet-dock-toggle-icon--to-wallet"></i>
            </button>
        </div>

        <div class="wallet-dock-scan-wrap">
            <button
                id="videoBtn"
                type="button"
                class="btn btn-primary wallet-dock-scan-btn rounded-circle border-0 shadow-lg"
                data-bs-toggle="modal"
                data-bs-target="#scanner-modal"
                aria-label="Scan QR code"
            >
                <i class="ti ti-qrcode"></i>
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@undecaf/zbar-wasm@0.11.0/dist/index.js"></script>
    <script src="{{ url_for('static', filename='qr-scanner.js') }}"></script>
</footer>

<style>
    .wallet-dock-footer {
        padding: 0.5rem 0 calc(0.65rem + env(safe-area-inset-bottom, 0px));
        background: linear-gradient(to top, var(--tblr-body-bg) 65%, transparent);
        pointer-events: none;
    }

    .wallet-dock-footer .wallet-dock-stack {
        pointer-events: auto;
    }

    .wallet-dock-stack {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.65rem;
    }

    .wallet-dock {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem;
        border: 1px solid var(--tblr-border-color);
        border-radius: 999px;
        background: var(--tblr-bg-surface);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
        width: 100%;
        max-width: 28rem;
    }

    .wallet-dock-panel {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: stretch;
        gap: 0.25rem;
    }

    .wallet-dock-panel--account {
        display: none;
    }

    .wallet-dock.mode-account .wallet-dock-panel--wallet {
        display: none;
    }

    .wallet-dock.mode-account .wallet-dock-panel--account {
        display: flex;
    }

    .wallet-dock-scan-wrap {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .wallet-dock-scan-btn {
        width: 3.5rem;
        height: 3.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .wallet-dock-scan-btn .ti {
        font-size: 1.5rem;
        line-height: 1;
    }

    .wallet-dock-scan-btn:hover,
    .wallet-dock-scan-btn:focus-visible {
        transform: translateY(-1px);
        box-shadow: 0 8px 24px rgba(var(--tblr-primary-rgb), 0.4) !important;
    }

    .wallet-dock-scan-btn:active {
        transform: scale(0.94);
    }

    .wallet-dock-nav-btn {
        flex: 1;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 3.1rem;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: var(--tblr-secondary);
        text-decoration: none;
        transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
    }

    .wallet-dock-nav-btn .ti {
        font-size: 1.3rem;
        line-height: 1;
    }

    .wallet-dock-nav-btn:hover,
    .wallet-dock-nav-btn:focus-visible {
        background: var(--tblr-bg-surface-secondary);
        color: var(--tblr-body-color);
    }

    .wallet-dock-nav-btn.active {
        background: rgba(var(--tblr-primary-rgb), 0.12);
        color: var(--tblr-primary);
    }

    .wallet-dock-nav-btn--danger:hover,
    .wallet-dock-nav-btn--danger:focus-visible {
        background: rgba(var(--tblr-danger-rgb), 0.12);
        color: var(--tblr-danger);
    }

    .wallet-dock-nav-btn:active {
        transform: scale(0.96);
    }

    .wallet-dock-count {
        position: absolute;
        top: 0.2rem;
        right: 0.45rem;
        min-width: 1.1rem;
        height: 1.1rem;
        padding: 0 0.25rem;
        border-radius: 999px;
        font-size: 0.6rem;
        font-weight: 700;
        line-height: 1.1rem;
        text-align: center;
    }

    .wallet-dock-toggle {
        flex: 0 0 auto;
        width: 2.65rem;
        height: 2.65rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--tblr-bg-surface-secondary);
    }

    .wallet-dock-toggle .ti {
        font-size: 1.2rem;
        line-height: 1;
    }

    .wallet-dock-toggle-icon--to-wallet {
        display: none;
    }

    .wallet-dock.mode-account .wallet-dock-toggle-icon--to-account {
        display: none;
    }

    .wallet-dock.mode-account .wallet-dock-toggle-icon--to-wallet {
        display: block;
    }

    .wallet-dock.mode-account .wallet-dock-toggle {
        background: rgba(var(--tblr-primary-rgb), 0.12);
        color: var(--tblr-primary);
    }
</style>

<script>
    (function initWalletDock() {
        const dock = document.getElementById('wallet-dock');
        const toggle = document.getElementById('wallet-dock-toggle');
        if (!dock || !toggle) return;

        function setDockPanel(panel) {
            const isAccount = panel === 'account';
            dock.classList.toggle('mode-account', isAccount);
            dock.classList.toggle('mode-wallet', !isAccount);
            toggle.setAttribute('aria-expanded', isAccount ? 'true' : 'false');
            toggle.setAttribute(
                'aria-label',
                isAccount ? 'Show wallet navigation' : 'Show account menu'
            );
        }

        toggle.addEventListener('click', function () {
            setDockPanel(dock.classList.contains('mode-account') ? 'wallet' : 'account');
        });
    })();
</script>
