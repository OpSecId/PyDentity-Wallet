{% extends('layouts/base.min.jinja') %}
{% block page %}
<script>
    if (!(/Mobi|Android|iPhone/i.test(navigator.userAgent))) {
        window.location.replace("{{ url_for('install') }}");
    }
</script>

<div class="page page-center">
    <div class="container container-tight py-4">
        <div class="text-center mb-4">
            <a href="{{ url_for('auth.index') }}" class="navbar-brand navbar-brand-autodark">
                <img src="{{ session['app_logo'] }}" width="200" height="auto" alt="{{ title }}" class="navbar-brand-image">
            </a>
        </div>

        <div class="card card-md">
            <div class="card-body text-center py-5">
                <h2 class="mb-2">Your digital identity wallet</h2>
                <p class="text-secondary mb-4">
                    Store credentials, connect with issuers, and present verifiable information securely.
                </p>

                <div class="d-grid gap-2">
                    <a href="{{ url_for('auth.sign_in') }}" class="btn btn-primary btn-lg">
                        Sign in
                    </a>
                    <a href="{{ url_for('auth.create_wallet') }}" class="btn btn-outline-primary btn-lg">
                        Create wallet
                    </a>
                </div>
            </div>

            <div class="card-footer">
                <a href="{{ url_for('install') }}" class="btn btn-ghost-secondary w-100">
                    Install app on this device
                </a>
            </div>
        </div>

        <p class="text-center text-secondary mt-4 mb-0">
            <small>Secured with passkeys · OpenWallet Foundation Labs</small>
        </p>
    </div>
</div>
{% endblock %}
