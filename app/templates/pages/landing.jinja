{% extends('layouts/base.min.jinja') %}
{% block page %}
<script>
    if (!(/Mobi|Android|iPhone/i.test(navigator.userAgent))) {
        window.location.replace("{{ url_for('install') }}");
    }
</script>

<div class="container container-tight py-4">
    <div class="text-center mb-4">
        <a href="." class="navbar-brand navbar-brand-autodark">
            <img width="220" src="{{ session['app_logo'] }}" alt="{{ title }}">
        </a>
    </div>

    <div class="card card-md">
        <div class="card-body text-center py-4">
            <h2 class="mb-2">Your digital identity wallet</h2>
            <p class="text-muted mb-4">
                Store credentials, connect with issuers, and present verifiable information securely.
            </p>

            <div class="d-grid gap-2">
                <a href="{{ url_for('auth.sign_in') }}" class="btn btn-primary btn-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon me-2">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                        <polyline points="10 17 15 12 10 7"></polyline>
                        <line x1="15" y1="12" x2="3" y2="12"></line>
                    </svg>
                    Sign in
                </a>
                <a href="{{ url_for('auth.create_wallet') }}" class="btn btn-outline-primary btn-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon me-2">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>
                    Create wallet
                </a>
                <a href="{{ url_for('install') }}" class="btn btn-outline-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon me-2">
                        <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"></path>
                        <path d="M7 11l5 5l5 -5"></path>
                        <path d="M12 4l0 12"></path>
                    </svg>
                    Install app
                </a>
            </div>
        </div>
        <div class="card-footer text-center text-muted small">
            Secured with passkeys · OpenWallet Foundation Labs
        </div>
    </div>
</div>

<style>
    .page-center {
        min-height: 100vh;
    }
</style>
{% endblock %}
