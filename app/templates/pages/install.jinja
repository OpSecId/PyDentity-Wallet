{% extends('layouts/base.min.jinja') %}
{% block page %}

<div class="page page-center">
    <div class="container container-tight py-4">
        <div class="text-center mb-4">
            <a href="{{ url_for('install') }}" class="navbar-brand navbar-brand-autodark">
                <img src="{{ session['app_logo'] }}" width="200" height="auto" alt="{{ app_name }}" class="navbar-brand-image">
            </a>
        </div>

        <div class="card card-md">
            <div class="card-body text-center py-5">
                <div class="mb-4">
                    <span class="avatar avatar-xl bg-primary-lt text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
                            <rect x="7" y="4" width="10" height="16" rx="1"></rect>
                            <path d="M11 5h2"></path>
                            <path d="M12 17v.01"></path>
                        </svg>
                    </span>
                </div>

                <h2 class="mb-2">Open on your mobile device</h2>
                <p class="text-secondary mb-4">
                    PyDentity Wallet is designed for mobile. Scan the QR code with your phone to get started.
                </p>

                <div class="mb-4">
                    <div class="d-inline-block p-3 bg-white rounded shadow-sm">
                        <img src="{{ qrcode(app_url) }}" alt="Scan to open wallet" class="rounded" style="max-width: 260px; width: 100%;">
                    </div>
                </div>

                <p class="text-secondary small mb-0">
                    Or open <strong class="text-body">{{ app_url }}</strong> on your mobile browser
                </p>
            </div>

            <div class="card-footer">
                <a href="{{ project_url }}" target="_blank" rel="noopener" class="btn btn-ghost-secondary w-100">
                    Learn more about PyDentity Wallet
                </a>
            </div>
        </div>

        {% if demo_url %}
        <div class="card card-md mt-3 bg-primary-lt border-0">
            <div class="card-body">
                <div class="d-flex align-items-start gap-3">
                    <span class="avatar bg-primary text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
                            <path d="M13 2L3 14h9l-1 8l10-12h-9l1-8z"></path>
                        </svg>
                    </span>
                    <div class="flex-fill">
                        <h3 class="card-title mb-1">Try a live demo</h3>
                        <p class="text-secondary mb-3">
                            Scan the QR code with your phone first, then open the demo issuer on this desktop browser.
                        </p>
                        <a href="{{ demo_url }}" target="_blank" rel="noopener" class="btn btn-primary">
                            Open demo issuer
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        <p class="text-center text-secondary mt-4 mb-0">
            <small>Secured with passkeys · <a href="https://openwallet.foundation" target="_blank" rel="noopener" class="text-secondary">OpenWallet Foundation</a></small>
        </p>
    </div>
</div>

{% endblock %}
