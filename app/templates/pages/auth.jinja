{% extends('layouts/base.min.jinja') %}
{% block page %}
{% if not session.get('development') %}
<script>
    if (!(/Mobi|Android|iPhone/i.test(navigator.userAgent))) {
        window.location.replace("{{ url_for('install') }}");
    }
</script>
{% endif %}
<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
<script src="https://unpkg.com/@simplewebauthn/browser/dist/bundle/index.umd.min.js"></script>
<script>
    const { startRegistration, startAuthentication } = SimpleWebAuthnBrowser;
    const AUTH_MODE = {{ mode|tojson }};
</script>

<div class="page page-center">
    <div class="container container-tight py-4">
        <div class="text-center mb-4">
            <a href="{{ url_for('auth.index') }}" class="navbar-brand navbar-brand-autodark">
                <img src="{{ session['app_logo'] }}" width="200" height="auto" alt="{{ title }}" class="navbar-brand-image">
            </a>
        </div>

        <div class="card card-md">
            <div class="card-body text-center py-5">
                <h2 class="mb-2">{{ 'Sign in' if mode == 'sign-in' else 'Create wallet' }}</h2>
                <p class="text-secondary mb-4" id="auth-subtitle">
                    {% if mode == 'sign-in' %}
                    Use your passkey to unlock the wallet saved on this device.
                    {% else %}
                    Set up a new wallet secured with a passkey on this device.
                    {% endif %}
                </p>

                <div id="auth-loading" class="progress progress-sm mb-3" hidden>
                    <div class="progress-bar progress-bar-indeterminate"></div>
                </div>
                <p id="auth-status" class="text-secondary mb-3" hidden></p>

                <div class="d-grid gap-2" id="auth-primary">
                    <a id="start-auth" href="#" class="btn btn-primary btn-lg" style="display: none;"></a>
                    <div id="auth-actions" class="d-grid gap-2" style="display: none;"></div>
                </div>
            </div>

            <div class="card-footer">
                <a href="{{ url_for('auth.index') }}" class="btn btn-ghost-secondary w-100">
                    Back to welcome
                </a>
            </div>
        </div>

        <p class="text-center text-secondary mt-4 mb-0">
            <small>Secured with passkeys · OpenWallet Foundation Labs</small>
        </p>
    </div>
</div>

<script>
    function setAuthStatus(message) {
        const status = document.getElementById('auth-status');
        const subtitle = document.getElementById('auth-subtitle');
        if (!status) return;
        if (message) {
            status.textContent = message;
            status.hidden = false;
            if (subtitle) subtitle.hidden = true;
        } else {
            status.hidden = true;
            if (subtitle) subtitle.hidden = false;
        }
    }

    function clearStoredClient() {
        localStorage.removeItem('clientId');
    }

    function showAuthLoading() {
        document.getElementById('auth-loading').removeAttribute('hidden');
    }

    function setupAuthButton(label, handler) {
        const button = document.getElementById('start-auth');
        button.textContent = label;
        button.style.display = '';
        button.onclick = async (event) => {
            event.preventDefault();
            showAuthLoading();
            await handler();
        };
    }

    function showAuthActions(html) {
        const actions = document.getElementById('auth-actions');
        const startAuth = document.getElementById('start-auth');
        actions.innerHTML = html;
        actions.style.display = 'grid';
        if (startAuth) startAuth.style.display = 'none';
    }

    function beginRegistration() {
        setAuthStatus('Setting up a new wallet...');
        const endpoint = '{{ url_for("auth.register") }}';
        $.get(endpoint)
            .done(function (data) {
                setAuthStatus('');
                setupAuthButton('Create wallet with passkey', async () => {
                    const attResp = await startRegistration({ optionsJSON: data });
                    const verificationResp = await fetch(endpoint, {
                        method: 'POST',
                        body: JSON.stringify(attResp)
                    });
                    const verificationJSON = await verificationResp.json();

                    if (verificationJSON && verificationJSON.verified) {
                        localStorage.setItem('clientId', verificationJSON.client_id);
                        window.location.replace("{{ url_for('main.index') }}");
                    } else {
                        setAuthStatus('Registration failed. Please try again.');
                    }
                });
                document.getElementById('start-auth').click();
            })
            .fail(function () {
                setAuthStatus('Could not start registration. Please refresh and try again.');
            });
    }

    function beginLogin(clientId) {
        setAuthStatus('Checking for your wallet...');
        const endpoint = `{{ url_for("auth.login") }}?client_id=${clientId}`;
        $.get(endpoint)
            .done(function (data) {
                setAuthStatus('Confirm with your passkey to sign in.');
                setupAuthButton('Sign in with passkey', async () => {
                    const asseResp = await startAuthentication({ optionsJSON: data });
                    const verificationResp = await fetch(endpoint, {
                        method: 'POST',
                        body: JSON.stringify(asseResp),
                    });
                    const verificationJSON = await verificationResp.json();

                    if (verificationJSON && verificationJSON.verified) {
                        window.location.replace("{{ url_for('main.index') }}");
                    } else {
                        setAuthStatus('Sign in failed. Please try again.');
                    }
                });
                document.getElementById('start-auth').click();
            })
            .fail(function (xhr) {
                const response = xhr.responseJSON || {};
                clearStoredClient();
                if (xhr.status === 404 || response.error === 'wallet_not_found') {
                    setAuthStatus('No wallet found on this server for this device.');
                    showAuthActions(`
                        <a href="{{ url_for('auth.create_wallet') }}" class="btn btn-primary btn-lg">Create a new wallet</a>
                    `);
                } else {
                    setAuthStatus('Could not restore your session. Please try again.');
                    showAuthActions(`
                        <a href="{{ url_for('auth.sign_in') }}" class="btn btn-outline-primary btn-lg">Try again</a>
                    `);
                }
            });
    }

    if (AUTH_MODE === 'create') {
        clearStoredClient();
        beginRegistration();
    } else {
        const clientId = localStorage.getItem('clientId');
        if (clientId) {
            beginLogin(clientId);
        } else {
            setAuthStatus('No wallet is saved on this device yet.');
            showAuthActions(`
                <a href="{{ url_for('auth.create_wallet') }}" class="btn btn-primary btn-lg">Create a wallet</a>
            `);
        }
    }
</script>

{% endblock %}
