{% extends('layouts/base.min.jinja') %}
{% block page %}
{% if not session.get('development') %}
<script>
    if (!(/Mobi|Android|iPhone/i.test(navigator.userAgent))) {
        window.location.replace("/install");
    }
</script>
{% endif %}
<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
<script src="https://unpkg.com/htmx.org@1.7.0"></script>
<script src="https://unpkg.com/@simplewebauthn/browser/dist/bundle/index.umd.min.js"></script>
<script>
    const { startRegistration, startAuthentication } = SimpleWebAuthnBrowser;
</script>

<div class="container container-tight py-4" onload="accessWallet()">
    <div class="text-center mb-4">
        <a href="." class="navbar-brand navbar-brand-autodark">
            <img width="220px" src="{{ session['app_logo'] }}">
        </a>
    </div>
    <div id="loading-access" class="progress progress-sm" style="display: none;">
        <div class="progress-bar progress-bar-indeterminate"></div>
    </div>
    <div class="card-md">
        <div class="card-body text-center">
            <div id="auth-loading" class="progress progress-sm" hidden>
                <div class="progress-bar progress-bar-indeterminate"></div>
            </div>
            <p id="auth-status" class="text-muted mt-3 mb-0"></p>
            <a id="start-auth" href="#" class="btn btn-outline-dark btn-lg" style="display: none;"></a>
        </div>
    </div>
</div>



<script>
    function setAuthStatus(message) {
        const status = document.getElementById('auth-status');
        if (status) status.textContent = message;
    }

    function clearStoredClient() {
        localStorage.removeItem('clientId');
    }

    function showAuthLoading() {
        $('#auth-loading').removeAttr('hidden');
    }

    function setupAuthButton(label, handler) {
        const button = document.getElementById('start-auth');
        button.textContent = label;
        button.style.display = '';
        button.onclick = async (event) => {
            event.preventDefault();
            showAuthLoading();
            await handler();
        };
        button.click();
    }

    function beginRegistration() {
        setAuthStatus('Setting up a new wallet...');
        const endpoint = '{{ url_for("auth.register") }}';
        $.get(endpoint)
            .done(function (data) {
                setupAuthButton('Create wallet', async () => {
                    const attResp = await startRegistration({ optionsJSON: data });
                    const verificationResp = await fetch(endpoint, {
                        method: 'POST',
                        body: JSON.stringify(attResp)
                    });
                    const verificationJSON = await verificationResp.json();

                    if (verificationJSON && verificationJSON.verified) {
                        localStorage.setItem('clientId', verificationJSON.client_id);
                        window.location.replace("{{ url_for('main.index') }}");
                    } else {
                        setAuthStatus('Registration failed. Please try again.');
                        alert("Failure");
                    }
                });
            })
            .fail(function () {
                setAuthStatus('Could not start registration. Please refresh and try again.');
            });
    }

    function beginLogin(clientId) {
        setAuthStatus('Checking for your wallet...');
        const endpoint = `{{ url_for("auth.login") }}?client_id=${clientId}`;
        $.get(endpoint)
            .done(function (data) {
                setAuthStatus('Confirm with your passkey to sign in.');
                setupAuthButton('Sign in', async () => {
                    const asseResp = await startAuthentication({ optionsJSON: data });
                    const verificationResp = await fetch(endpoint, {
                        method: 'POST',
                        body: JSON.stringify(asseResp),
                    });
                    const verificationJSON = await verificationResp.json();

                    if (verificationJSON && verificationJSON.verified) {
                        window.location.replace("{{ url_for('main.index') }}");
                    } else {
                        setAuthStatus('Sign in failed. Please try again.');
                        alert("login failed");
                        console.error(verificationJSON);
                    }
                });
            })
            .fail(function (xhr) {
                const response = xhr.responseJSON || {};
                console.warn('Login unavailable for stored client', clientId, response);
                clearStoredClient();
                if (xhr.status === 404 || response.error === 'wallet_not_found') {
                    setAuthStatus('No wallet found on this server. Creating a new wallet...');
                } else {
                    setAuthStatus('Could not restore your session. Creating a new wallet...');
                }
                beginRegistration();
            });
    }

    const clientId = localStorage.getItem('clientId');
    if (clientId) {
        beginLogin(clientId);
    } else {
        beginRegistration();
    }
</script>


{% endblock %}